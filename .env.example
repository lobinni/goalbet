# ─── Database ──────────────────────────────────────────────
# Required. PostgreSQL connection string.
# Local dev:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Vercel:     Set in Vercel Dashboard → Settings → Environment Variables
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Football API (optional) ──────────────────────────────
# Get a free key at https://www.football-data.org/client/register
# Without this, the app uses realistic mock fixtures.
FOOTBALL_DATA_API_KEY=

# ─── GenLayer Contract (optional) ─────────────────────────
# The deployed GoalBet contract address on GenLayer StudioNet.
# Leave empty to use the local PostgreSQL backend only.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x60fcDCeF6C6881ADD3A9327eE7F7EFeBf50aEC71
